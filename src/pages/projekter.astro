---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="projekter">
  <div class="mt-8 ml-8">
    <h1 class="text-4xl font-bold mb-2" style="color: var(--color-text);">
      Mine Projekter
    </h1>
    <p class="text-lg mb-6 max-w-2xl" style="color: var(--color-text);">
      Her kan du udforske nogle af de projekter, jeg har lavet gennem tiden.
      Nogle er eksperimenter, andre er små spil – alle lavet for sjov og for at
      lære mere om webudvikling.
    </p>
    <div class="mt-8 ml-8 flex flex-row gap-2">
      <div
        class="project-card p-6 rounded-xl border-4 shadow-2xl w-80 flex-shrink-0 transition-transform hover:scale-105"
        style="background-color: var(--color-cardBg); border-color: var(--color-accent);"
      >
        <a
          href="/Gamle side/index.html"
          class="block w-full text-center"
          style="background-color: var(--color-accent); color: white; padding: 0.5rem 1rem; border-radius: 0.25rem; text-decoration: none;"
          onmouseover="this.style.backgroundColor='var(--color-accentLight)'; this.style.color='var(--color-text)';"
          onmouseout="this.style.backgroundColor='var(--color-accent)'; this.style.color='white';"
          >Gamle Side</a
        >
        <p class="max-w-xl mt-2 text-base" style="color: var(--color-text);">
          "Gamle Side" er min gamle hjemmeside, som jeg lavede for et godt
          stykke tid siden. Kvaliteten er meget blandet, men det var sjovt at
          lave og et godt eksperiment med webudvikling. Siden indeholder alt fra
          små spil til eksperimentelle sider og gamle projekter.
        </p>
      </div>
      <div
        class="project-card p-6 rounded-xl border-4 shadow-2xl w-80 flex-shrink-0 transition-transform hover:scale-105"
        style="background-color: var(--color-cardBg); border-color: var(--color-accent);"
      >
        <a
          href="/Gamle side/spil/klike spil/Klike spil.html"
          class="block w-full text-center"
          style="background-color: var(--color-accent); color: white; padding: 0.5rem 1rem; border-radius: 0.25rem; text-decoration: none;"
          onmouseover="this.style.backgroundColor='var(--color-accentLight)'; this.style.color='var(--color-text)';"
          onmouseout="this.style.backgroundColor='var(--color-accent)'; this.style.color='white';"
          >Klike spil</a
        >
        <p class="max-w-xl mt-2 text-base" style="color: var(--color-text);">
          "Klike spil" er et simpelt klik-spil jeg har lavet, hvor du skal
          klikke så mange gange som muligt på kort tid. Spillet er lavet for
          sjov og for at øve JavaScript og webudvikling. Prøv det og se hvor
          mange klik du kan nå!
        </p>
      </div>
    </div>
  </div>
  <style>
    a {
      padding: 0.5rem 1rem;
      text-decoration: none;
      border-radius: 0.25rem;
    }
  </style>
  <style>
    .project-card {
      transition:
        transform 0.2s,
        box-shadow 0.2s;
      position: relative;
    }
    .project-card:hover {
      z-index: 10;
      transform: scale(1.15);
      box-shadow:
        0 8px 32px 0 rgba(0, 0, 0, 0.25),
        0 1.5px 6px 0 rgba(0, 0, 0, 0.15);
    }
  </style>
</BaseLayout>
