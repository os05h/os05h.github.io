---
import ThemeSelector from "./ThemeSelector.astro";
---

<div
    class="nav-container bg-[var(--color-navBg)] flex justify-between items-center px-8 py-4 space-x-8"
>
    <div class="nav-links flex space-x-8">
        <a
            href="/"
            class="bg-[var(--color-accent)] hover:bg-[var(--color-accentLight)] hover:text-[var(--color-navBg)] px-4 py-2 rounded transition"
            >Home</a
        >
        <a
            href="/projekter"
            class="bg-[var(--color-accent)] hover:bg-[var(--color-accentLight)] hover:text-[var(--color-navBg)] px-4 py-2 rounded transition"
            >Projekter</a
        >
    </div>
    <ThemeSelector />
</div>

<style>
    .nav-container {
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    }

    a {
        text-decoration: none;
        font-weight: 500;
        transition: all 0.2s ease;
    }
</style>
