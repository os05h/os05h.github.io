---
const { platform, username } = Astro.props;
---

<a
    href={`https://www.${platform}.com/${username}`}
    class="social-link"
    style="background-color: var(--color-accent); color: var(--color-text);"
    onmouseover="this.style.backgroundColor='var(--color-accentLight)';"
    onmouseout="this.style.backgroundColor='var(--color-accent)';">{platform}</a
>

<style>
    a {
        padding: 0.5rem 1rem;
        text-decoration: none;
        border-radius: 0.25rem;
        transition: all 0.2s ease;
        font-weight: 500;
    }
</style>
