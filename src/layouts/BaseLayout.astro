---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { themes } from "../themes.js";
import "../styles/global.css";

const { title } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <script is:inline define:vars={{ themesJSON: JSON.stringify(themes) }}>
            // Apply saved theme immediately before page renders
            const themesData = JSON.parse(themesJSON);
            const savedTheme =
                localStorage.getItem("selectedTheme") || "blueOcean";
            const theme = themesData[savedTheme];

            if (theme && theme.colors) {
                const colors = theme.colors;
                document.documentElement.style.setProperty(
                    "--color-primary",
                    colors.primary,
                );
                document.documentElement.style.setProperty(
                    "--color-secondary",
                    colors.secondary,
                );
                document.documentElement.style.setProperty(
                    "--color-accent",
                    colors.accent,
                );
                document.documentElement.style.setProperty(
                    "--color-accentLight",
                    colors.accentLight,
                );
                document.documentElement.style.setProperty(
                    "--color-background",
                    colors.background,
                );
                document.documentElement.style.setProperty(
                    "--color-cardBg",
                    colors.cardBg,
                );
                document.documentElement.style.setProperty(
                    "--color-text",
                    colors.text,
                );
                document.documentElement.style.setProperty(
                    "--color-navBg",
                    colors.navBg,
                );
            }
        </script>
        <style>
            :root {
                --color-primary: #1a759f;
                --color-secondary: #184e77;
                --color-accent: #52b69a;
                --color-accentLight: #d9ed92;
                --color-background: #1a759f;
                --color-cardBg: #eff7ff;
                --color-text: #1a759f;
                --color-navBg: #1e6091;
            }
        </style>
    </head>
    <body
        class="min-h-screen flex flex-col p-4 md:p-8"
        style="background-color: var(--color-background);"
    >
        <div
            class="flex-1 flex flex-col max-w-4xl mx-auto w-full rounded-lg shadow-lg overflow-hidden"
            style="background-color: var(--color-cardBg);"
        >
            <Header />
            <!-- <h1>{title}</h1> -->
            <slot class="flex-1" />
            <Footer />
        </div>
    </body>
</html>
